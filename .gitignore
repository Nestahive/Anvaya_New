# =============================================================================
# Anvaya Project Root .gitignore
# =============================================================================

# ── 1. Secrets & Environment Files ──
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Firebase & Cloud Service Account Keys / Secrets
*-firebase-adminsdk-*.json
firebase-adminsdk-*.json
service-account*.json
credentials.json
client_secrets*.json

# ── 2. Python & Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.manifest
*.spec

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ── 3. Flutter & Dart ──
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
farmer/build/
anvaya-farmer/farmer/build/
**/build/

# Android build outputs & local config
farmer/android/.gradle/
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/gradle/wrapper/gradle-wrapper.jar
*.apk
*.aab
*.ap_

# iOS / macOS build outputs
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner.xcworkspace/
**/macos/Pods/

# ── 4. Node, React Native & Web ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
.next/
out/
web-build/

# ── 5. Machine Learning Models & Heavy Artifacts ──
*.pth
*.pt
*.onnx
*.bin
*.tflite
*.h5
*.pkl

# ── 6. IDEs & Editors ──
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak

# ── 7. Operating System ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── 8. Logs & Temporary Files ──
*.log
scratch/
tmp/
temp/
.claude/
.git-backup/
